{
  "name": "nextpaper",
  "displayName": "NextPaper",
  "version": "1.0.0",
  "description": "Find, triage and cite related literature while you read: papers ranked by semantic similarity, grouped by subtopic and ready to cite.",
  "author": "Angel Zamora <angelzamora1616@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/zamora16/NextPaper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zamora16/NextPaper.git"
  },
  "bugs": {
    "url": "https://github.com/zamora16/NextPaper/issues"
  },
  "keywords": [
    "chrome-extension",
    "literature-review",
    "semantic-scholar",
    "research-tools",
    "citations",
    "embeddings",
    "clustering"
  ],
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "check:cycles": "npx --yes madge@8.0.0 --circular --extensions ts,tsx --ts-config tsconfig.json popup.tsx background.ts",
    "test:e2e": "node scripts/e2e-offline.cjs",
    "check:api": "node scripts/api-contract.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --check \"{lib,components,tests}/**/*.{ts,tsx}\" popup.tsx background.ts vitest.config.ts",
    "format": "prettier --write \"{lib,components,tests}/**/*.{ts,tsx}\" popup.tsx background.ts vitest.config.ts"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.6.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "5.3.3",
    "vitest": "^2.1.9"
  },
  "manifest": {
    "host_permissions": [
      "https://api.semanticscholar.org/*",
      "https://api.crossref.org/*",
      "https://api.unpaywall.org/*"
    ],
    "permissions": [
      "activeTab",
      "alarms",
      "scripting",
      "storage",
      "unlimitedStorage"
    ]
  }
}
